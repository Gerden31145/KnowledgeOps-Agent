NODE_ENV=development
LOG_LEVEL=info

NUXT_PUBLIC_API_BASE_URL=http://127.0.0.1:4000
API_HOST=127.0.0.1
API_PORT=4000

# Stage 1/2 local-only identity. Production replaces this provider with GitHub login.
DEVELOPMENT_USER_ID=00000000-0000-4000-8000-000000000001
DEVELOPMENT_USER_TIMEZONE=Asia/Shanghai

# Public model metadata only. API keys remain separate server secrets and never enter this JSON.
# The browser only receives id + label. Provider/model stay server-side; the API key is separate.
PLAN_GENERATION_PROVIDER=openai
PLAN_GENERATION_MODELS_JSON=[{"id":"openai-primary","label":"Fast model","model":"gpt-5.4-mini"}]
PLAN_GENERATION_PROMPT_VERSION=plan-generation-v1
PLAN_GENERATION_OUTPUT_SCHEMA_VERSION=plan-generation-output-v1
PLAN_GENERATION_TIMEOUT_MS=180000
OPENAI_API_KEY=

POSTGRES_USER=knowledgeops
POSTGRES_PASSWORD=knowledgeops_dev
POSTGRES_DB=knowledgeops
POSTGRES_SHADOW_DB=knowledgeops_shadow
POSTGRES_BIND_HOST=127.0.0.1
POSTGRES_PORT=5432
DATABASE_URL=postgresql://knowledgeops:knowledgeops_dev@127.0.0.1:5432/knowledgeops?schema=public&sslmode=disable
SHADOW_DATABASE_URL=postgresql://knowledgeops:knowledgeops_dev@127.0.0.1:5432/knowledgeops_shadow?schema=public&sslmode=disable

REDIS_PORT=6379
REDIS_BIND_HOST=127.0.0.1
REDIS_URL=redis://127.0.0.1:6379

WORKER_CONCURRENCY=2
KNOWLEDGEOPS_WSL_DISTRO=Ubuntu
