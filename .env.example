NODE_ENV=development
LOG_LEVEL=info

NUXT_PUBLIC_API_BASE_URL=http://127.0.0.1:4000
API_HOST=127.0.0.1
API_PORT=4000
WEB_ORIGIN=http://127.0.0.1:3000

# Legacy Stage 1/2 test/seed settings only. HTTP requests never fall back to this identity.
DEVELOPMENT_USER_ID=00000000-0000-4000-8000-000000000001
DEVELOPMENT_USER_TIMEZONE=Asia/Shanghai

# R04 product GitHub login. Sessions live in PostgreSQL; no GitHub token reaches the browser.
# Copy values into the local .env only; never use NUXT_PUBLIC_ for the client secret.
# Use the App's Client ID, not its numeric App ID. See docs/local-development.md section 5.4.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_CALLBACK_URL=http://127.0.0.1:4000/auth/github/callback

# R04 repository access: absolute path to the App's downloaded PEM private key.
# Keep the key in .secrets/ locally (Git-ignored); use a protected secret mount in production.
# Reuses GITHUB_APP_CLIENT_ID for app authentication; never put key contents in public config.
GITHUB_APP_PRIVATE_KEY_PATH=

# R05: dedicated random Webhook secret, 32-256 characters; not the OAuth client secret.
# Configure locally only when the signature handwriting has passed review.
GITHUB_WEBHOOK_SECRET=

# Public model metadata only. API keys remain separate server secrets and never enter this JSON.
# The browser only receives id + label. Provider/model stay server-side; the API key is separate.
PLAN_GENERATION_PROVIDER=openai
PLAN_GENERATION_MODELS_JSON=[{"id":"openai-primary","label":"Fast model","model":"gpt-5.4-mini"}]
# GLM-5.3 example: [{"id":"glm-primary","label":"GLM-5.3","model":"glm-5.3","reasoningEffort":"low"}]
# Reasoning effort is frozen on each new plan Run; omission preserves provider defaults.
PLAN_GENERATION_PROMPT_VERSION=plan-generation-v3
PLAN_GENERATION_OUTPUT_SCHEMA_VERSION=plan-generation-output-v3
PLAN_GENERATION_TIMEOUT_MS=180000
# Course packages include lesson sections and exercises, so their deadline is independent.
COURSE_GENERATION_TIMEOUT_MS=600000
OPENAI_API_KEY=
# Optional OpenAI-compatible endpoint; leave unset for the official endpoint.
OPENAI_BASE_URL=
# Selected-text Q&A runs in the Worker; answer depth has separate output token caps.
COURSE_QUESTION_TIMEOUT_MS=60000
# Use jsonMode for providers supporting json_object but not strict json_schema (e.g. GLM).
PLAN_GENERATION_OUTPUT_METHOD=jsonSchema

# R09/R10 note and answer consumers: opt in after reviewing model/pricing.
# Blank leaves both Outbox types pending. Each Run has its own budget/ledger;
# note checking and question generation share the note Run's two-call limit.
# Reuses OPENAI_API_KEY / OPENAI_BASE_URL / PLAN_GENERATION_OUTPUT_METHOD.
# User-supplied GLM-5.3 price snapshot (2026-10-27): input CNY 8, output CNY 28 / million tokens.
# Microcurrency = 1/1,000,000 CNY. Cache-hit input (CNY 2) is not yet separated by accounting;
# ordinary input pricing gives an estimate, not the provider invoice. No credentials in JSON.
# GLM-5.3 默认 max 思考；小额度结构化验收显式选 low，首次领取时随 Run 冻结。
# NOTE_VERIFICATION_MODEL_JSON={"catalogId":"glm-5-3","modelName":"glm-5.3","reasoningEffort":"low","currency":"CNY","inputMicrounitsPerMillionTokens":8000000,"outputMicrounitsPerMillionTokens":28000000}
NOTE_VERIFICATION_MODEL_JSON=
NOTE_VERIFICATION_TIMEOUT_MS=180000
NOTE_VERIFICATION_MAX_TOTAL_TOKENS=32000
NOTE_VERIFICATION_MAX_OUTPUT_TOKENS=4096
NOTE_VERIFICATION_MAX_COST_MICROUNITS=1000000

POSTGRES_USER=knowledgeops
POSTGRES_PASSWORD=knowledgeops_dev
POSTGRES_DB=knowledgeops
POSTGRES_SHADOW_DB=knowledgeops_shadow
POSTGRES_BIND_HOST=127.0.0.1
POSTGRES_PORT=5432
DATABASE_URL=postgresql://knowledgeops:knowledgeops_dev@127.0.0.1:5432/knowledgeops?schema=public&sslmode=disable
SHADOW_DATABASE_URL=postgresql://knowledgeops:knowledgeops_dev@127.0.0.1:5432/knowledgeops_shadow?schema=public&sslmode=disable

REDIS_PORT=6379
REDIS_BIND_HOST=127.0.0.1
REDIS_URL=redis://127.0.0.1:6379

WORKER_CONCURRENCY=2
BULLMQ_JOB_ATTEMPTS=3
BULLMQ_JOB_BACKOFF_MS=1000
OUTBOX_BATCH_SIZE=20
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_RETRY_BASE_DELAY_MS=1000
OUTBOX_RETRY_MAX_DELAY_MS=60000
PLAN_GENERATION_TIMEOUT_SWEEP_BATCH_SIZE=20
PLAN_GENERATION_TIMEOUT_SWEEP_INTERVAL_MS=5000
KNOWLEDGEOPS_WSL_DISTRO=Ubuntu
