{
  "name": "knowledgeops-agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24.11.0 <25",
    "pnpm": ">=10.34.5 <11"
  },
  "scripts": {
    "build": "pnpm db:generate && pnpm -r --if-present build",
    "build:packages": "pnpm db:generate && pnpm --filter \"./packages/**\" build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm db:validate && pnpm test",
    "db:format": "prisma format",
    "db:generate": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:status": "prisma migrate status",
    "db:validate": "prisma validate",
    "dev": "pnpm build:packages && dotenv -e .env -- concurrently --kill-others --names WEB,API,WORKER --prefix-colors cyan,green,magenta \"pnpm --filter @knowledgeops/web dev\" \"pnpm --filter @knowledgeops/api dev\" \"pnpm --filter @knowledgeops/worker dev\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:check": "dotenv -e .env -- tsx scripts/infra-check.ts",
    "infra:compose:status": "node scripts/infra-control.mjs compose-status",
    "infra:compose:stop": "node scripts/infra-control.mjs compose-stop",
    "infra:compose:up": "node scripts/infra-control.mjs compose-up",
    "infra:status": "node scripts/infra-control.mjs native-status",
    "infra:stop": "node scripts/infra-control.mjs native-stop",
    "infra:up": "node scripts/infra-control.mjs native-up",
    "lint": "eslint .",
    "local:r11": "node --env-file=.env scripts/r11-local.mjs",
    "postinstall": "pnpm build:packages && pnpm --filter @knowledgeops/web prepare",
    "test": "pnpm db:generate && vitest run",
    "test:e2e:r16": "pnpm build:packages && pnpm --filter @knowledgeops/api build && pnpm --filter @knowledgeops/web build && playwright test",
    "test:handwrite:day-08-06-goal-input": "vitest run packages/contracts/test/learning-goal-input.exercise.ts",
    "test:handwrite:day-08-07-plan-query": "dotenv -e .env -- vitest run --config vitest.handwrite.day-08-07.config.ts",
    "test:handwrite:day-08-08-plan-dependencies": "vitest run --config vitest.handwrite.day-08-08.config.ts",
    "test:handwrite:day-08-09-bullmq": "dotenv -e .env -- vitest run --config vitest.handwrite.day-08-09.config.ts",
    "test:handwrite:day-08-10-dag": "vitest run --config vitest.handwrite.day-08-10.config.ts",
    "test:handwrite:day-08-11-query": "vitest run --config vitest.handwrite.day-08-11.config.ts",
    "test:integration:day-08-07": "dotenv -e .env -- vitest run --config vitest.integration.day-08-07.config.ts",
    "test:integration:day-08-09": "dotenv -e .env -- vitest run --config vitest.integration.day-08-09.config.ts",
    "test:integration:day-08-10": "dotenv -e .env -- vitest run --config vitest.integration.day-08-10.config.ts",
    "test:integration:day-08-11": "dotenv -e .env -- vitest run --config vitest.integration.day-08-11.config.ts",
    "test:integration:r04": "dotenv -e .env -- vitest run --config vitest.integration.r04.config.ts",
    "test:integration:r05": "dotenv -e .env -- vitest run --config vitest.integration.r05.config.ts",
    "test:integration:r06": "dotenv -e .env -- vitest run --config vitest.integration.r06.config.ts",
    "test:integration:r09": "node --env-file=.env node_modules/vitest/vitest.mjs run --config vitest.integration.r09.config.ts",
    "test:integration:r10": "node --env-file=.env node_modules/vitest/vitest.mjs run --config vitest.integration.r10.config.ts",
    "test:integration:r11": "node --env-file=.env node_modules/vitest/vitest.mjs run --config vitest.integration.r11.config.ts",
    "verify:r09:live": "node --env-file=.env --import tsx apps/worker/scripts/verify-note-live.ts",
    "eval:r11": "node --env-file=.env --import tsx apps/worker/scripts/evaluate-verification.ts",
    "test:integration:r13": "dotenv -e .env -- vitest run --config vitest.integration.r13.config.ts",
    "test:integration:r15": "node --env-file=.env node_modules/vitest/vitest.mjs run --config vitest.integration.r15.config.ts",
    "test:integration:r16": "node --import tsx tests/e2e/run-regression.ts",
    "test:handwrite:health-controller": "vitest run apps/api/test/health.controller.spec.ts",
    "test:handwrite:r04-auth-callback": "vitest run --config vitest.handwrite.r04.config.ts",
    "test:handwrite:r05-signature": "vitest run --config vitest.handwrite.r05.config.ts",
    "test:handwrite:r08-section": "vitest run --config vitest.handwrite.r08.config.ts",
    "test:handwrite:r11-task-state": "vitest run --config vitest.handwrite.r11.config.ts",
    "test:handwrite:r14-recovery": "vitest run --config vitest.handwrite.r14.config.ts",
    "test:handwrite:stage-1-recovery": "vitest run packages/contracts/test/run-termination-recovery.exercise.ts",
    "test:handwrite:stage-2-finalization": "dotenv -e .env -- vitest run --config vitest.handwrite.stage-2-finalization.config.ts",
    "test:handwrite:task-state": "vitest run --config vitest.handwrite.config.ts",
    "test:watch": "pnpm db:generate && vitest",
    "typecheck": "pnpm build:packages && pnpm -r --if-present typecheck && pnpm typecheck:e2e",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json",
    "verify:ci": "pnpm check && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.13.3",
    "@types/pg": "8.20.2",
    "concurrently": "10.0.4",
    "dotenv": "17.4.2",
    "dotenv-cli": "11.0.0",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.10.0",
    "globals": "17.8.0",
    "pg": "8.22.0",
    "prettier": "3.9.6",
    "prisma": "7.9.1",
    "redis": "6.2.0",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10",
    "vue-eslint-parser": "10.3.0",
    "zod": "4.4.3"
  }
}
