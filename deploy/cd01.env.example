# WSL/Linux only. Synthetic credentials: never copy production .env into this lab.
# Paths in COMPOSE_FILE are relative to the repository root; service paths use deploy/.
COMPOSE_FILE=deploy/compose.yaml:deploy/compose.apps.yaml:deploy/compose.cd01.yaml
COMPOSE_PROJECT_NAME=knowledgeops-cd01
APP_ENV_FILE=.env.cd01
GITHUB_APP_SECRETS_DIR=../tests/deploy/empty-secrets

POSTGRES_DB=knowledgeops_cd01
POSTGRES_USER=cd01
POSTGRES_PASSWORD=cd01_local_only
# Kept for the base Compose file; the CD01 override removes storage host ports.
POSTGRES_BIND_HOST=127.0.0.1
POSTGRES_PORT=25432
REDIS_BIND_HOST=127.0.0.1
REDIS_PORT=26379
CONTAINER_DATABASE_URL=postgresql://cd01:cd01_local_only@postgres:5432/knowledgeops_cd01
API_BIND_PORT=14000
WEB_BIND_PORT=13200

# The lab verifies startup and synthetic queue processing, not live GitHub OAuth.
WEB_ORIGIN=https://cd01.invalid
NUXT_PUBLIC_API_BASE_URL=http://127.0.0.1:14000
GITHUB_APP_CLIENT_ID=cd01-synthetic-app
GITHUB_APP_CLIENT_SECRET=cd01-synthetic-secret
GITHUB_APP_CALLBACK_URL=https://cd01.invalid/api/auth/github/callback
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=cd01-synthetic-webhook-secret-000000000000

OPENAI_API_KEY=cd01-synthetic-key
OPENAI_BASE_URL=http://model:4100/v1
PLAN_GENERATION_OUTPUT_METHOD=jsonMode
NOTE_VERIFICATION_MODEL_JSON=
WORKER_CONCURRENCY=1
OUTBOX_POLL_INTERVAL_MS=500
