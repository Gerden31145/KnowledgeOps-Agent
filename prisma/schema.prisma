generator client {
  provider        = "prisma-client"
  output          = "../packages/database/src/generated/prisma"
  moduleFormat    = "esm"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum PlanStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum TaskState {
  BLOCKED
  READY
  IN_PROGRESS
  VERIFYING
  NEEDS_REVISION
  NEEDS_EVIDENCE
  PASSED
}

enum TaskType {
  MARKDOWN_NOTE
  COURSE
}

enum CourseStatus {
  PENDING
  GENERATING
  READY
  FAILED
}

enum CourseKnowledgeRole {
  TEACH
  REVIEW
}

enum CourseQuestionDepth {
  QUICK
  CONTEXTUAL
  DEEP
}

enum CourseQuestionStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

enum AcceptanceCriterionType {
  FILE_CHANGED
  SECTION_PRESENT
  CONTENT_MINIMUM
  SEMANTIC_CORRECTNESS
  TOPIC_COVERAGE
  EXPLANATION_QUALITY
  FOLLOW_UP_ANSWER
}

enum PlanGenerationRunState {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  TIMED_OUT
}

enum OutboxEventType {
  PLAN_GENERATION_REQUESTED
  COURSE_GENERATION_REQUESTED
  GITHUB_PUSH_RECEIVED
  GITHUB_EVIDENCE_RETRY_REQUESTED
  NOTE_VERIFICATION_REQUESTED
  ANSWER_VERIFICATION_REQUESTED
}

enum AgentRunKind {
  NOTE_VERIFICATION
  ANSWER_VERIFICATION
}

enum AgentRunState {
  QUEUED
  RUNNING
  CANCEL_REQUESTED
  SUCCEEDED
  FAILED
  CANCELLED
  TIMED_OUT
}

model User {
  id                String           @id @default(uuid()) @db.Uuid
  githubUserId      String?          @unique @map("github_user_id")
  githubLogin       String?          @map("github_login")
  timezone          String           @default("Asia/Shanghai")
  preferredModelId  String?          @map("preferred_model_id") @db.VarChar(100)
  goals             LearningGoal[]
  sessions          Session[]
  courseQuestions   CourseQuestion[]
  repositories      Repository[]
  repositoryVersion Int              @default(0) @map("repository_version")
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("users")
}

model Session {
  tokenHash String   @id @map("token_hash") @db.VarChar(64)
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model GitHubInstallation {
  id           String       @id @db.VarChar(32)
  accountId    String       @map("account_id") @db.VarChar(32)
  accountLogin String       @map("account_login") @db.VarChar(100)
  verifiedAt   DateTime     @map("verified_at") @db.Timestamptz(3)
  repositories Repository[]

  @@map("github_installations")
}

model Repository {
  id                 String             @id @default(uuid()) @db.Uuid
  userId             String             @map("user_id") @db.Uuid
  installationId     String             @map("installation_id") @db.VarChar(32)
  githubRepositoryId String             @map("github_repository_id") @db.VarChar(32)
  fullName           String             @map("full_name") @db.VarChar(220)
  defaultBranch      String             @map("default_branch") @db.VarChar(255)
  branch             String             @db.VarChar(255)
  isPrivate          Boolean            @map("is_private")
  enabled            Boolean            @default(true)
  boundAt            DateTime           @default(now()) @map("bound_at") @db.Timestamptz(3)
  unboundAt          DateTime?          @map("unbound_at") @db.Timestamptz(3)
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  installation       GitHubInstallation @relation(fields: [installationId], references: [id], onDelete: Restrict)
  submissions        Submission[]
  receivedDeliveries WebhookDelivery[]

  @@unique([userId], map: "repositories_one_enabled_per_user", where: raw("enabled"))
  @@unique([githubRepositoryId], map: "repositories_one_enabled_per_github_repository", where: raw("enabled"))
  @@index([installationId, githubRepositoryId, enabled])
  @@map("repositories")
}

model LearningGoal {
  id                 String              @id @default(uuid()) @db.Uuid
  userId             String              @map("user_id") @db.Uuid
  title              String              @db.VarChar(160)
  currentLevel       String              @map("current_level") @db.VarChar(500)
  deadline           DateTime            @db.Date
  weeklyMinutes      Int                 @map("weekly_minutes")
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  plans              Plan[]
  planGenerationRuns PlanGenerationRun[]
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([userId, createdAt])
  @@map("learning_goals")
}

model Plan {
  id              String             @id @default(uuid()) @db.Uuid
  goalId          String             @map("goal_id") @db.Uuid
  generationRunId String?            @unique @map("generation_run_id") @db.Uuid
  version         Int                @default(1)
  status          PlanStatus         @default(DRAFT)
  confirmedAt     DateTime?          @map("confirmed_at") @db.Timestamptz(3)
  goal            LearningGoal       @relation(fields: [goalId], references: [id], onDelete: Cascade)
  generationRun   PlanGenerationRun? @relation(fields: [generationRunId], references: [id], onDelete: Restrict)
  stages          Stage[]
  knowledgePoints KnowledgePoint[]
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([goalId, version])
  @@index([status])
  @@map("plans")
}

model Stage {
  id        String   @id @default(uuid()) @db.Uuid
  planId    String   @map("plan_id") @db.Uuid
  title     String   @db.VarChar(160)
  position  Int
  plan      Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  tasks     Task[]
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([planId, position])
  @@map("stages")
}

model Task {
  id               String                @id @default(uuid()) @db.Uuid
  stageId          String                @map("stage_id") @db.Uuid
  title            String                @db.VarChar(160)
  description      String                @db.Text
  position         Int
  type             TaskType              @default(MARKDOWN_NOTE)
  estimatedMinutes Int                   @map("estimated_minutes")
  suggestedSteps   String[]              @default([]) @map("suggested_steps")
  targetPath       String?               @map("target_path") @db.VarChar(1024)
  state            TaskState             @default(BLOCKED)
  version          Int                   @default(0)
  stage            Stage                 @relation(fields: [stageId], references: [id], onDelete: Cascade)
  prerequisites    TaskDependency[]      @relation("TaskPrerequisites")
  dependents       TaskDependency[]      @relation("TaskDependents")
  criteria         AcceptanceCriterion[]
  runs             AgentRun[]
  submissions      Submission[]
  course           Course?
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([stageId, position])
  @@index([state, updatedAt])
  @@map("tasks")
}

model AcceptanceCriterion {
  id          String                  @id @default(uuid()) @db.Uuid
  taskId      String                  @map("task_id") @db.Uuid
  type        AcceptanceCriterionType
  description String                  @db.Text
  required    Boolean                 @default(true)
  position    Int
  config      Json?                   @db.JsonB
  task        Task                    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt   DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([taskId, position])
  @@map("acceptance_criteria")
}

model TaskDependency {
  taskId             String @map("task_id") @db.Uuid
  prerequisiteTaskId String @map("prerequisite_task_id") @db.Uuid
  task               Task   @relation("TaskPrerequisites", fields: [taskId], references: [id], onDelete: Cascade)
  prerequisiteTask   Task   @relation("TaskDependents", fields: [prerequisiteTaskId], references: [id], onDelete: Cascade)

  @@id([taskId, prerequisiteTaskId])
  @@index([prerequisiteTaskId])
  @@map("task_dependencies")
}

model AgentRun {
  id                     String                     @id @default(uuid()) @db.Uuid
  taskId                 String                     @map("task_id") @db.Uuid
  submissionId           String?                    @map("submission_id") @db.Uuid
  answerSubmissionId     String?                    @map("answer_submission_id") @db.Uuid
  expectedTaskVersion    Int?                       @map("expected_task_version")
  kind                   AgentRunKind
  status                 AgentRunState              @default(QUEUED)
  taskStateBeforeRun     TaskState                  @map("task_state_before_run")
  retryOfRunId           String?                    @map("retry_of_run_id") @db.Uuid
  workflowVersion        String                     @map("workflow_version") @db.VarChar(64)
  errorCode              String?                    @map("error_code") @db.VarChar(64)
  deadlineAt             DateTime?                  @map("deadline_at") @db.Timestamptz(3)
  executionConfiguration Json?                      @map("execution_configuration") @db.JsonB
  version                Int                        @default(0)
  queuedAt               DateTime                   @default(now()) @map("queued_at") @db.Timestamptz(3)
  startedAt              DateTime?                  @map("started_at") @db.Timestamptz(3)
  finishedAt             DateTime?                  @map("finished_at") @db.Timestamptz(3)
  task                   Task                       @relation(fields: [taskId], references: [id], onDelete: Restrict)
  submission             Submission?                @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  answerSubmission       AnswerSubmission?          @relation(fields: [answerSubmissionId], references: [id], onDelete: Restrict)
  deliveries             WebhookDelivery[]
  retryOfRun             AgentRun?                  @relation("AgentRunRetries", fields: [retryOfRunId], references: [id], onDelete: SetNull)
  retries                AgentRun[]                 @relation("AgentRunRetries")
  modelExecution         NoteVerificationExecution?
  report                 VerificationReport?
  createdAt              DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([submissionId], map: "agent_runs_one_initial_per_submission", where: raw("(retry_of_run_id IS NULL)"))
  @@unique([answerSubmissionId], map: "agent_runs_one_initial_per_answer", where: raw("(retry_of_run_id IS NULL)"))
  @@index([taskId, queuedAt])
  @@index([status, queuedAt])
  @@map("agent_runs")
}

model VerificationReport {
  id               String            @id @default(uuid()) @db.Uuid
  runId            String            @unique @map("run_id") @db.Uuid
  body             Json              @db.JsonB
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  run              AgentRun          @relation(fields: [runId], references: [id], onDelete: Cascade)
  followUpQuestion FollowUpQuestion?

  @@map("verification_reports")
}

// 一份笔记报告最多一道追问；body 固定原 Submission/Commit、评分要点及原文引用。
model FollowUpQuestion {
  id        String             @id @default(uuid()) @db.Uuid
  reportId  String             @unique @map("report_id") @db.Uuid
  body      Json               @db.JsonB
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  report    VerificationReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  answers   AnswerSubmission[]

  @@map("follow_up_questions")
}

// 回答引用原追问，追问经 Report → 笔记 Run → Submission 固定原笔记；不伪造 GitHub 提交。
model AnswerSubmission {
  id                  String           @id @default(uuid()) @db.Uuid
  questionId          String           @map("question_id") @db.Uuid
  requestId           String           @map("request_id") @db.Uuid
  expectedTaskVersion Int              @map("expected_task_version")
  content             String           @db.Text
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  question            FollowUpQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)
  runs                AgentRun[]

  @@unique([questionId, requestId])
  @@map("answer_submissions")
}

// 笔记与回答共用按 Run 隔离的执行账本；保留 R09 表名，不替代正式报告或 Task 状态。
model NoteVerificationExecution {
  runId              String    @id @map("run_id") @db.Uuid
  claimToken         String    @map("claim_token") @db.Uuid
  runVersion         Int       @map("run_version")
  requestFingerprint String    @map("request_fingerprint") @db.VarChar(64)
  configuration      Json      @db.JsonB
  deadlineAt         DateTime  @map("deadline_at") @db.Timestamptz(3)
  attemptCount       Int       @default(0) @map("attempt_count")
  pendingAttempt     Int?      @map("pending_attempt")
  accounting         Json      @db.JsonB
  result             Json?     @db.JsonB
  startedAt          DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt         DateTime? @map("finished_at") @db.Timestamptz(3)
  run                AgentRun  @relation(fields: [runId], references: [id], onDelete: Cascade, map: "note_verification_executions_run_fkey")

  @@map("note_verification_executions")
}

// R06 笔记提交：一份固定 Commit 的证据可以被不同的重试运行引用，不覆盖旧证据。
model Submission {
  id              String            @id @default(uuid()) @db.Uuid
  repositoryId    String            @map("repository_id") @db.Uuid
  taskId          String            @map("task_id") @db.Uuid
  taskVersion     Int               @map("task_version")
  beforeCommitSha String            @map("before_commit_sha") @db.VarChar(40)
  afterCommitSha  String            @map("after_commit_sha") @db.VarChar(40)
  targetPath      String            @map("target_path") @db.VarChar(1024)
  workflowVersion String            @map("workflow_version") @db.VarChar(64)
  repository      Repository        @relation(fields: [repositoryId], references: [id], onDelete: Restrict)
  task            Task              @relation(fields: [taskId], references: [id], onDelete: Restrict)
  evidence        Evidence?
  runs            AgentRun[]
  deliveries      WebhookDelivery[]
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([repositoryId, taskId, afterCommitSha, workflowVersion], map: "submissions_note_business_key")
  @@index([taskId, createdAt])
  @@map("submissions")
}

// 当前只保存一个任务目标文件的完整证据；删除保存 before 正文，不冒充当前文件。
model Evidence {
  id              String     @id @default(uuid()) @db.Uuid
  submissionId    String     @unique @map("submission_id") @db.Uuid
  // SNAPSHOT 记录显式全文重新同步及 FILE_CHANGED 免检依据；不伪报变更类型。
  mode            String     @default("DIFF") @db.VarChar(16)
  change          String?    @db.VarChar(16)
  previousPath    String?    @map("previous_path") @db.VarChar(1024)
  sourceCommitSha String     @map("source_commit_sha") @db.VarChar(40)
  content         String     @db.Text
  contentHash     String     @map("content_hash") @db.VarChar(64)
  lineCount       Int        @map("line_count")
  diff            String?    @db.Text
  submission      Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("evidence")
}

model Course {
  id             String                 @id @default(uuid()) @db.Uuid
  taskId         String                 @unique @map("task_id") @db.Uuid
  status         CourseStatus           @default(PENDING)
  task           Task                   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  versions       CourseVersion[]
  generationRuns CourseGenerationRun[]
  knowledge      CourseKnowledgePoint[]
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status])
  @@map("courses")
}

model CourseGenerationRun {
  id                   String                 @id @default(uuid()) @db.Uuid
  courseId             String                 @map("course_id") @db.Uuid
  status               PlanGenerationRunState @default(QUEUED)
  retryOfRunId         String?                @map("retry_of_run_id") @db.Uuid
  modelCatalogId       String                 @map("model_catalog_id") @db.VarChar(100)
  modelProvider        String                 @map("model_provider") @db.VarChar(64)
  modelName            String                 @map("model_name") @db.VarChar(160)
  modelReasoningEffort String?                @map("model_reasoning_effort") @db.VarChar(16)
  promptVersion        String                 @map("prompt_version") @db.VarChar(64)
  outputSchemaVersion  String                 @map("output_schema_version") @db.VarChar(64)
  profileSnapshot      Json                   @default("[]") @map("profile_snapshot") @db.JsonB
  errorCode            String?                @map("error_code") @db.VarChar(64)
  errorMessage         String?                @map("error_message") @db.VarChar(500)
  version              Int                    @default(0)
  deadlineAt           DateTime               @map("deadline_at") @db.Timestamptz(3)
  queuedAt             DateTime               @default(now()) @map("queued_at") @db.Timestamptz(3)
  startedAt            DateTime?              @map("started_at") @db.Timestamptz(3)
  finishedAt           DateTime?              @map("finished_at") @db.Timestamptz(3)
  course               Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  retryOfRun           CourseGenerationRun?   @relation("CourseGenerationRunRetries", fields: [retryOfRunId], references: [id], onDelete: SetNull)
  retries              CourseGenerationRun[]  @relation("CourseGenerationRunRetries")
  courseVersion        CourseVersion?
  createdAt            DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([courseId], map: "course_generation_runs_one_active_per_course", where: raw("(status = ANY (ARRAY['QUEUED'::\"PlanGenerationRunState\", 'RUNNING'::\"PlanGenerationRunState\"]))"))
  @@index([courseId, queuedAt])
  @@index([status, deadlineAt])
  @@map("course_generation_runs")
}

model CourseVersion {
  id              String              @id @default(uuid()) @db.Uuid
  courseId        String              @map("course_id") @db.Uuid
  generationRunId String              @unique @map("generation_run_id") @db.Uuid
  version         Int
  content         Json                @db.JsonB
  course          Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  generationRun   CourseGenerationRun @relation(fields: [generationRunId], references: [id], onDelete: Restrict)
  exerciseSet     ExerciseSet?
  questions       CourseQuestion[]
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([courseId, version])
  @@map("course_versions")
}

model CourseQuestion {
  id              String               @id @default(uuid()) @db.Uuid
  courseVersionId String               @map("course_version_id") @db.Uuid
  userId          String               @map("user_id") @db.Uuid
  requestId       String               @map("request_id") @db.Uuid
  fingerprint     String               @db.Char(64)
  sectionId       String               @map("section_id") @db.VarChar(64)
  selectedText    String               @map("selected_text") @db.Text
  question        String               @db.Text
  depth           CourseQuestionDepth
  status          CourseQuestionStatus @default(RUNNING)
  answer          String?              @db.Text
  errorCode       String?              @map("error_code") @db.VarChar(64)
  modelCatalogId  String               @map("model_catalog_id") @db.VarChar(100)
  modelProvider   String               @map("model_provider") @db.VarChar(64)
  modelName       String               @map("model_name") @db.VarChar(160)
  completedAt     DateTime?            @map("completed_at") @db.Timestamptz(3)
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  courseVersion   CourseVersion        @relation(fields: [courseVersionId], references: [id], onDelete: Cascade)
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, requestId])
  @@index([courseVersionId, userId, createdAt])
  @@map("course_questions")
}

model ExerciseSet {
  id              String        @id @default(uuid()) @db.Uuid
  courseVersionId String        @unique @map("course_version_id") @db.Uuid
  body            Json          @db.JsonB
  courseVersion   CourseVersion @relation(fields: [courseVersionId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("exercise_sets")
}

model KnowledgePoint {
  id          String                 @id @default(uuid()) @db.Uuid
  planId      String                 @map("plan_id") @db.Uuid
  key         String                 @db.VarChar(64)
  title       String                 @db.VarChar(120)
  description String                 @db.VarChar(500)
  plan        Plan                   @relation(fields: [planId], references: [id], onDelete: Cascade)
  courses     CourseKnowledgePoint[]
  createdAt   DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([planId, key])
  @@map("knowledge_points")
}

model CourseKnowledgePoint {
  courseId         String              @map("course_id") @db.Uuid
  knowledgePointId String              @map("knowledge_point_id") @db.Uuid
  role             CourseKnowledgeRole @default(TEACH)
  course           Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  knowledgePoint   KnowledgePoint      @relation(fields: [knowledgePointId], references: [id], onDelete: Cascade)

  @@id([courseId, knowledgePointId])
  @@index([knowledgePointId])
  @@map("course_knowledge_points")
}

model PlanGenerationRun {
  id                   String                 @id @default(uuid()) @db.Uuid
  goalId               String                 @map("goal_id") @db.Uuid
  status               PlanGenerationRunState @default(QUEUED)
  retryOfRunId         String?                @map("retry_of_run_id") @db.Uuid
  modelCatalogId       String                 @map("model_catalog_id") @db.VarChar(100)
  modelProvider        String                 @map("model_provider") @db.VarChar(64)
  modelName            String                 @map("model_name") @db.VarChar(160)
  modelReasoningEffort String?                @map("model_reasoning_effort") @db.VarChar(16)
  promptVersion        String                 @map("prompt_version") @db.VarChar(64)
  outputSchemaVersion  String                 @map("output_schema_version") @db.VarChar(64)
  errorCode            String?                @map("error_code") @db.VarChar(64)
  errorMessage         String?                @map("error_message") @db.VarChar(500)
  version              Int                    @default(0)
  deadlineAt           DateTime               @map("deadline_at") @db.Timestamptz(3)
  queuedAt             DateTime               @default(now()) @map("queued_at") @db.Timestamptz(3)
  startedAt            DateTime?              @map("started_at") @db.Timestamptz(3)
  finishedAt           DateTime?              @map("finished_at") @db.Timestamptz(3)
  goal                 LearningGoal           @relation(fields: [goalId], references: [id], onDelete: Cascade)
  retryOfRun           PlanGenerationRun?     @relation("PlanGenerationRunRetries", fields: [retryOfRunId], references: [id], onDelete: SetNull)
  retries              PlanGenerationRun[]    @relation("PlanGenerationRunRetries")
  plan                 Plan?
  createdAt            DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([goalId], map: "plan_generation_runs_one_active_per_goal", where: raw("(status = ANY (ARRAY['QUEUED'::\"PlanGenerationRunState\", 'RUNNING'::\"PlanGenerationRunState\"]))"))
  @@index([goalId, queuedAt])
  @@index([status, deadlineAt])
  @@map("plan_generation_runs")
}

// 接收与取证处理状态，不等于 AgentRun 验收结果。
model WebhookDelivery {
  id           String      @id @db.Uuid
  eventType    String      @map("event_type") @db.VarChar(64)
  payloadHash  String      @map("payload_hash") @db.VarChar(64)
  status       String      @db.VarChar(16)
  ignoreReason String?     @map("ignore_reason") @db.VarChar(64)
  payload      Json        @db.JsonB
  receivedAt   DateTime    @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt  DateTime?   @map("processed_at") @db.Timestamptz(3)
  submissionId String?     @map("submission_id") @db.Uuid
  agentRunId   String?     @map("agent_run_id") @db.Uuid
  submission   Submission? @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  agentRun     AgentRun?   @relation(fields: [agentRunId], references: [id], onDelete: Restrict)

  // 接收时冻结的本项目绑定；即使没有当前任务/Outbox，也能安全展示忽略原因。
  // 解绑后新建的同仓库绑定不会继承旧通知；无法证明归属的历史记录保持 null。
  receivedRepositoryId String?     @map("received_repository_id") @db.Uuid
  receivedRepository   Repository? @relation(fields: [receivedRepositoryId], references: [id], onDelete: SetNull)

  // 取证先于 AgentRun：ACCEPTED 只表示已接收，失败/重试另记，不伪造验收结论。
  evidenceAttemptCount  Int       @default(0) @map("evidence_attempt_count")
  evidenceLastAttemptAt DateTime? @map("evidence_last_attempt_at") @db.Timestamptz(3)
  evidenceLastErrorCode String?   @map("evidence_last_error_code") @db.VarChar(64)
  evidenceFailedAt      DateTime? @map("evidence_failed_at") @db.Timestamptz(3)
  // 当前手动恢复请求；原始尝试为 null，防止旧队列通知覆盖新一轮结果。
  evidenceRetryEventId  String?   @map("evidence_retry_event_id") @db.Uuid

  @@index([receivedRepositoryId, receivedAt, id])
  @@map("webhook_deliveries")
}

model OutboxEvent {
  id                   String          @id @default(uuid()) @db.Uuid
  type                 OutboxEventType
  aggregateId          String          @map("aggregate_id") @db.Uuid
  deduplicationKey     String          @unique @map("deduplication_key") @db.VarChar(200)
  payload              Json            @db.JsonB
  schemaVersion        Int             @default(1) @map("schema_version")
  availableAt          DateTime        @default(now()) @map("available_at") @db.Timestamptz(3)
  dispatchedAt         DateTime?       @map("dispatched_at") @db.Timestamptz(3)
  deadLetteredAt       DateTime?       @map("dead_lettered_at") @db.Timestamptz(3)
  dispatchAttemptCount Int             @default(0) @map("dispatch_attempt_count")
  lastError            String?         @map("last_error") @db.Text
  occurredAt           DateTime        @default(now()) @map("occurred_at") @db.Timestamptz(3)
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([dispatchedAt, deadLetteredAt, availableAt])
  @@index([type, aggregateId])
  @@map("outbox_events")
}
